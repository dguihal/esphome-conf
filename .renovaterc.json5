{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':separateMajorReleases',
    ':combinePatchMinorReleases',
  ],
  timezone: 'Europe/Paris',
  labels: [
    'dependencies',
    'esphome',
  ],
  packageRules: [
    {
      description: 'Automerge uniquement pour les outils de CI (GitHub Actions)',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'Validation manuelle requise pour ESPHome et les composants externes',
      matchManagers: [
        'custom.regex',
      ],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Suit la branche déclarée des composants GitHub tout en conservant un SHA épinglé',
      managerFilePatterns: [
        '/\\.ya?ml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*branch=(?<currentValue>[A-Za-z0-9_.\\/-]+)\\s*\\n\\s*- source:\\s*github://(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)@(?<currentDigest>[0-9a-f]{40})(?:\\s|$)',
      ],
      packageNameTemplate: '{{{depName}}}',
      datasourceTemplate: 'github-digest',
    },
    {
      customType: 'regex',
      description: "Détecte l'image Docker ESPHome dans les workflows GitHub",
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.yml$/',
      ],
      matchStrings: [
        'esphome/esphome:(?<currentValue>[^\\s"\']+)',
      ],
      depNameTemplate: 'esphome/esphome',
      datasourceTemplate: 'docker',
    },
  ],
}
